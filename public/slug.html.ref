dcrumbList">  <a href="#" class="breadcrumb__ellipsis" itemprop="item">    Home  </a>        <span class="breadcrumb__separator-root">/</span>              <span class="breadcrumb__item" itemprop="itemListElement" itemscope="true" itemtype="https://schema.org/ListItem">  <a href="#" class="breadcrumb__link" itemprop="item" rel="noopener">    <span itemprop="name">Segments</span>  </a>  </span>                    <span class="breadcrumb__separator">/</span>        <span class="breadcrumb__item" itemprop="itemListElement" itemscope="true" itemtype="https://schema.org/ListItem">  <span itemprop="name">Earth observation</span>  </span>  </nav><div class="image-container"><figure class="hero__video"><div class="hero__background-container"><video height="1080" style="aspect-ratio: 1920 / 1080;" width="1920" autoplay="" loop="" muted="" poster="/assets-f/img/e2f918aac9ba26.png" playsinline="" class="hero__video"><source src="/assets-f/media/f90002a08069f9.mp4" type="video/mp4"></video></div></figure><h1 class="hero__title hero-r3" data-original-html="&lt;span class=&quot;generic-span&quot;&gt;Earth&lt;/span&gt; observation " style="visibility: visible;"><span class="hero__title-split-line line" style="display: block; text-align: start; width: 100%;"><span class="hero__title-split-word word hero__title-original-span" style="display: inline-block; --line-opacity: 0;"><span class="hero__title-split-char char hero__title-original-span" style="display: inline-block; opacity: 1;">E</span><span class="hero__title-split-char char hero__title-original-span" style="display: inline-block; opacity: 1;">a</span><span class="hero__title-split-char char hero__title-original-span" style="display: inline-block; opacity: 1;">r</span><span class="hero__title-split-char char hero__title-original-span" style="display: inline-block; opacity: 1;">t</span><span class="hero__title-split-char char hero__title-original-span" style="display: inline-block; opacity: 1;">h</span></span> <span class="hero__title-split-word word" style="display: inline-block; --line-opacity: 0;"><span class="hero__title-split-char char" style="display: inline-block; opacity: 1;">o</span><span class="hero__title-split-char char" style="display: inline-block; opacity: 1;">b</span><span class="hero__title-split-char char" style="display: inline-block; opacity: 1;">s</span><span class="hero__title-split-char char" style="display: inline-block; opacity: 1;">e</span><span class="hero__title-split-char char" style="display: inline-block; opacity: 1;">r</span><span class="hero__title-split-char char" style="display: inline-block; opacity: 1;">v</span><span class="hero__title-split-char char" style="display: inline-block; opacity: 1;">a</span><span class="hero__title-split-char char" style="display: inline-block; opacity: 1;">t</span><span class="hero__title-split-char char" style="display: inline-block; opacity: 1;">i</span><span class="hero__title-split-char char" style="display: inline-block; opacity: 1;">o</span><span class="hero__title-split-char char" style="display: inline-block; opacity: 1;">n</span></span></span></h1></div><div class="hero__subtitle-container"><div class="hero__subtitle-wrapper"><aside class="hero__aside"><p class="hero__subtitle">Intelligence for <span class="generic-span">the protection of our planet</span></p></aside><div class="hero__extra-content"><p class="generic-item">Indra Space combines the potential of artificial intelligence with state-of-the-art sensors to provide more precise, faster, and actionable information about our planet.</p><p class="generic-item">From advanced platforms and intelligent on-board processing, to mission control, data exploitation, and ground infrastructures, we deliver comprehensive Earth observation solutions that transform data into useful intelligence for decision-making.</p></div></div></div></div></section><section class="body-text body-text--featured-text body-text--light custom-image" id="body-text-4" itemtype="https://schema.org/Article" itemscope="" data-anchor="true"><div class="container"><h2 class="generic-item">Key features</h2><div class="body-text__container"><div class="body-text__text" itemprop="articleBody"><ul class="generic-item"><li>Design and integration of satellite platforms</li><li>On-board image processing optimised with AI for real-time analysis</li><li>Direct Tasking and flexible mission scheduling</li><li>State-of-the-art ground stations, mission control and data processing systems</li><li>Comprehensive platform for data exploitation and EO services</li></ul><div class=""></div></div><figure class="size-full body-text__image is-top-left"><img loading="lazy" decoding="async" width="1920" height="1920" src="/assets-f/img/3d5740e31b97bd.jpg" alt="" class="" title="" srcset="/assets-f/img/3d5740e31b97bd.jpg 1920w, /assets-f/img/664dfc1725871f.jpg 1536w" sizes="auto, (max-width: 1920px) 100vw, 1920px" style="translate: none; rotate: none; scale: none; opacity: 1; transform: translate(0px, 8vh) scale(1.3, 1.3);"></figure></div> </div></section><div class=""><section class="body-text body-text--text-image  custom-image body-text--light container" id="body-text-2" itemtype="https://schema.org/Article" itemscope="" data-anchor="true"><div class="container"><div class="body-text__container"><div class="body-text__text" itemprop="articleBody"><div class=""><h3 class="generic-item">Programmes</h3><section class="container grid-container"><div class="grid-container__variant2"><div class="grid-container-item"><ul class="generic-item"><li>Copernicus</li><li>PAZ</li><li>EPS</li></ul></div><div class="grid-container-item"><ul class="generic-item"><li>MTG</li><li>NAOS/ LUXEOS</li><li>Earth Explorer missions</li></ul></div></div></section></div></div><figure class="size-full body-text__image is-top-left"><img loading="lazy" decoding="async" width="1920" height="1080" src="/assets-f/img/9ff94331ed0793.jpg" alt="" class="" style="aspect-ratio: 4 / 3; object-fit: cover; translate: none; rotate: none; scale: none; opacity: 1; transform: translate(0px, 8vh) scale(1.3, 1.3);" title="" srcset="/assets-f/img/9ff94331ed0793.jpg 1920w, /assets-f/img/ff0db4c7249a8f.jpg 1536w" sizes="auto, (max-width: 1920px) 100vw, 1920px"></figure></div></div></section></div><div style="height:3rem" aria-hidden="true" class=""></div><div class="ceramic-bg"><div class="section-title"><div class="section-title__container container"><p class="section-title__subtitle">Solutions</p><div class="section-title__content"><h2 class="section-title__title"><span class="generic-span">Cutting-edge</span> technology</h2></div></div></div><div class=""><div class="container"><div class="grid-container__variant3 mosaic"><div class="grid-container-item"><article class="widget-item-grid-link" itemtype="https://schema.org/CreativeWork"><a href="#" itemprop="url" class="widget-item-grid-link__link" rel="noopener"><figure class="size-full widget-image background--center-left is-top-right"><img loading="lazy" decoding="async" width="1920" height="1080" src="/assets-f/img/8069246213a035.jpg" alt="" class="" itemprop="image" title="" srcset="/assets-f/img/8069246213a035.jpg 1920w, /assets-f/img/d5f3568fcd4757.jpg 1536w" sizes="auto, (max-width: 1920px) 100vw, 1920px"></figure><h3 class="widget-item-grid-link__heading" itemprop="name">Satellite platforms</h3></a></article></div><div class="grid-container-item"><article class="widget-item-grid-link" itemtype="https://schema.org/CreativeWork"><a href="#" itemprop="url" class="widget-item-grid-link__link" rel="noopener"><figure class="size-full widget-image background--center-left is-top-right"><img loading="lazy" decoding="async" width="1920" height="1080" src="/assets-f/img/7e9f5425e96322.jpg" alt="" class="" itemprop="image" title="" srcset="/assets-f/img/7e9f5425e96322.jpg 1920w, /assets-f/img/996ed5ec6c39f1.jpg 1536w" sizes="auto, (max-width: 1920px) 100vw, 1920px"></figure><h3 class="widget-item-grid-link__heading" itemprop="name">Avionics and ADCS</h3></a></article></div><div class="grid-container-item"><article class="widget-item-grid-link" itemtype="https://schema.org/CreativeWork"><a href="#" itemprop="url" class="widget-item-grid-link__link" rel="noopener"><figure class="size-full widget-image background--center-left is-top-right"><img loading="lazy" decoding="async" width="1920" height="1080" src="/assets-f/img/017d854f1ad222.jpg" alt="" class="" itemprop="image" title="" srcset="/assets-f/img/017d854f1ad222.jpg 1920w, /assets-f/img/aa9baf277e308f.jpg 1536w" sizes="auto, (max-width: 1920px) 100vw, 1920px"></figure><h3 class="widget-item-grid-link__heading" itemprop="name">Ground segment</h3></a></article></div><div class="grid-container-item"><article class="widget-item-grid-link" itemtype="https://schema.org/CreativeWork"><a href="#" itemprop="url" class="widget-item-grid-link__link" rel="noopener"><figure class="size-full widget-image background--center-left is-top-right"><img loading="lazy" decoding="async" width="1920" height="1080" src="/assets-f/img/5a4d8636dd8d63.jpg" alt="" class="" itemprop="image" title="" srcset="/assets-f/img/5a4d8636dd8d63.jpg 1920w, /assets-f/img/256c6ec470734c.jpg 1536w" sizes="auto, (max-width: 1920px) 100vw, 1920px"></figure><h3 class="widget-item-grid-link__heading" itemprop="name">Services and applications</h3></a></article></div></div></div></div><div style="height:8rem" aria-hidden="true" class=""></div></div><section class="divider-image  ceramic-bg"><figure class="size-full divider-image__figure background--top-center is-top-left"><img loading="lazy" decoding="async" width="1920" height="1080" src="/assets-f/img/fc2fedf52ecadd.jpg" alt="" class="" title="" srcset="/assets-f/img/fc2fedf52ecadd.jpg 1920w, /assets-f/img/4560a48bba71bd.jpg 1536w" sizes="auto, (max-width: 1920px) 100vw, 1920px" style="translate: none; rotate: none; scale: none; opacity: 1; transform: translate(0px, 7vh) scale(1.3, 1.3);"></figure></section><div class="ceramic-bg"><div style="he